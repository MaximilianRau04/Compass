# Local mail triage on a machine with Ollama: summarises mails of accounts with
# MAIL_TRIAGE_<ACCOUNT>=local and sends only the result to Compass.
# Install: see docs/deploy.md, section "Mails". Runs as your user, not as root.
[Unit]
Description=Compass local mail triage
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=oneshot
# @REPO@ is replaced with the checkout path on install (docs/deploy.md).
WorkingDirectory=@REPO@/backend
ExecStart=%h/.local/bin/uv run --frozen python -m app.mail.local_triage
# The model can take a while for a full batch.
TimeoutStartSec=20min
Nice=10
