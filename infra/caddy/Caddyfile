{
	admin off
	# Requests arrive through the reverse proxy in the VM (and the Docker gateway). Trusting private
	# ranges keeps the original client in X-Forwarded-For, so client_ip and the login throttle see it.
	# Strict: read X-Forwarded-For from the right and take the first untrusted address, so a value
	# the client made up at the left end is never taken, even if a proxy in front appends to it.
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

# TLS modes, selected with COMPASS_TLS_MODE
(tls-off) {
}

(tls-netcup) {
	# Let's Encrypt via DNS challenge, works although the server is only reachable in the VPN.
	# netcup DNS is slow to propagate, so the first certificate can take 10 to 15 minutes.
	tls {
		dns netcup {
			customer_number {env.NETCUP_CUSTOMER_NUMBER}
			api_key {env.NETCUP_API_KEY}
			api_password {env.NETCUP_API_PASSWORD}
		}
		propagation_timeout 900s
		propagation_delay 600s
		resolvers 1.1.1.1
	}
}

{$COMPASS_SITE_ADDRESS::80} {
	import tls-{$COMPASS_TLS_MODE:off}
	encode zstd gzip

	# Everyone in the tailnet can reach the server, so the app needs its own login.
	# /api/health stays open for monitoring. /api/ingest/* is for the health bridges on the phone
	# and the local mail triage; the API checks their own bearer tokens (HEALTH_TOKEN, ...).
	@protected not path /api/health /api/ingest/*
	basic_auth @protected {
		{$COMPASS_BASIC_AUTH_USER} {$COMPASS_BASIC_AUTH_HASH}
	}

	handle /api/* {
		# Browsers send the login along with requests from other sites too. The app only calls its
		# own origin, and the bridge app and the local triage send no Sec-Fetch-Site at all.
		@other_site {
			not method GET HEAD
			header Sec-Fetch-Site cross-site
			header Sec-Fetch-Site same-site
		}
		respond @other_site 403
		# The largest legitimate body is a Health Connect batch (20 MB). FastAPI reads a JSON body
		# before the bearer token of /api/ingest/* is checked, so cap it here.
		request_body {
			max_size 25MB
		}
		reverse_proxy api:8000
	}

	handle {
		# Not for /api/*: the API docs load their assets from a CDN. Bank logos come from outside.
		header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		# Built assets carry a hash in their name and never change. Everything else (index.html,
		# sw.js, the manifest) is revalidated on every load, so a deploy is picked up at once.
		@hashed path /assets/*
		header @hashed Cache-Control "private, max-age=31536000, immutable"
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}

# MCP endpoint for AI assistants, protected by OAuth instead of basic auth.
# Exposes /mcp plus the OAuth endpoints and the owner login page of the MCP service.
{$COMPASS_MCP_SITE_ADDRESS::8081} {
	import tls-{$COMPASS_TLS_MODE:off}
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	# Optional: only let the given ranges call the machine-to-machine endpoints (e.g. Anthropic's
	# outbound range 160.79.104.0/21). The login page stays reachable for your browser.
	@blocked {
		path /mcp /mcp/* /token /register /revoke
		not client_ip {$COMPASS_MCP_ALLOWED_IPS:0.0.0.0/0 ::/0}
	}
	respond @blocked 403
	reverse_proxy mcp:8001 {
		# Exactly the client address Caddy determined. uvicorn trusts the header (it is only reachable
		# through Caddy) and the login throttle counts failures per this address.
		header_up X-Forwarded-For {client_ip}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
