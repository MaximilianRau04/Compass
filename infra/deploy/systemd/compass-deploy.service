[Unit]
Description=Deploy the newest Compass commit once CI has published its images
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
# Adjust user and path to your setup (see docs/deploy.md). The user needs docker access and, for
# a private fork, the GHCR login and read access to the repository.
User=compass
WorkingDirectory=/opt/compass
ExecStart=/opt/compass/infra/deploy/auto-deploy.sh
