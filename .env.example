# Compass configuration template (no real values).
# Copy to .env and fill in. Never commit .env.

# --- Mail (IMAP, read-only: EXAMINE and BODY.PEEK, nothing is marked read, moved or deleted) ---
# An account is active when its host and user are set. Mail text is never stored.
MAIL_FOLDERS=INBOX
MAIL_SYNC_MINUTES=15
# How far back the first sync of an account looks
MAIL_LOOKBACK_DAYS=14
# Who summarises an account's mails: claude (Anthropic API, on the server), local (Ollama on the
# laptop, see app/mail/local_triage.py) or rules (headers only, no summary).
# Uni mails contain personal data of third parties: keep them local.
MAIL_TRIAGE_UNI=local
MAIL_TRIAGE_GMAIL=claude
MAIL_TRIAGE_DOMAIN=claude
# For "claude"; without a key those accounts fall back to rules
ANTHROPIC_API_KEY=
MAIL_CLAUDE_MODEL=claude-haiku-4-5
# Bearer token of the local triage runner for /api/ingest/mail/*, create with: openssl rand -hex 32
# Same value on the server and in the laptop's .env. Empty disables the endpoints.
MAIL_TRIAGE_TOKEN=
# Laptop only: where the runner finds Compass and Ollama
COMPASS_URL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- University mail (e.g. Exchange IMAP, read-only) ---
UNI_IMAP_HOST=
UNI_IMAP_PORT=993
# Often the student ID, not the full address
UNI_IMAP_USER=
UNI_IMAP_PASSWORD=

# --- Gmail (app password, requires 2FA) ---
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=

# --- Own domain ---
DOMAIN_IMAP_HOST=
DOMAIN_IMAP_PORT=993
DOMAIN_IMAP_USER=
DOMAIN_IMAP_PASSWORD=

# --- News (RSS/Atom feeds) ---
# Space separated stream:name=url; stream "personal" is ranked by the interest profile,
# "general" is world news. Unset uses the built-in list (backend/app/config.py), empty disables news.
# NEWS_FEEDS=general:tagesschau=https://www.tagesschau.de/index~rss2.xml personal:hn=https://hnrss.org/frontpage?points=100
NEWS_SYNC_MINUTES=60
NEWS_KEEP_DAYS=30

# --- Calendars (ICS, read-only) ---
# The ILIAS calendar subscription URL. Its deadline entries become tasks, everything else events.
ILIAS_ICS_URL=
# Further calendars as space separated name=url pairs, e.g. "google=https://... uni=webcal://..."
CALENDAR_ICS_FEEDS=
CALENDAR_SYNC_MINUTES=30
# Area per calendar (feed=area slug): its events take the area's colour and follow the area filter
CALENDAR_FEED_AREAS=ilias=uni campus=uni
# Area slug for new ILIAS deadline tasks (empty: none)
ILIAS_DEADLINE_AREA=uni

# --- General ---
# Language of the texts the server writes itself (push notifications, the weekly review, mail
# summaries, MCP prompts): en or de. The web app and the Android app follow the device language.
COMPASS_LANGUAGE=en
# Local time zone for "today", deadlines and the sleep analysis
TIMEZONE=Europe/Berlin

# --- Database ---
POSTGRES_USER=compass
POSTGRES_PASSWORD=
POSTGRES_DB=compass
POSTGRES_PORT=5432

# --- Web ---
# Host address and port Caddy is published on (localhost only by default)
COMPASS_HTTP_PORT=127.0.0.1:8080
# Caddy site address, ":80" both locally and on the server (TLS ends at the host proxy there)
COMPASS_SITE_ADDRESS=:80
# "off" unless Caddy terminates TLS itself; "netcup" gets Let's Encrypt via the netcup DNS challenge
COMPASS_TLS_MODE=off

# --- netcup DNS API (only for COMPASS_TLS_MODE=netcup, CCP > Stammdaten > API) ---
NETCUP_CUSTOMER_NUMBER=
NETCUP_API_KEY=
NETCUP_API_PASSWORD=

# --- Login (Caddy basic auth) ---
COMPASS_BASIC_AUTH_USER=admin
# bcrypt hash, create with: make password-hash
# Every $ in the hash must be written as $$ (Docker Compose escaping).
COMPASS_BASIC_AUTH_HASH=

# --- Health Connect bridge app (android/) ---
# Bearer token the app sends to /api/ingest/healthconnect, create with: openssl rand -hex 32
# Empty disables the endpoint.
HEALTHCONNECT_TOKEN=
# Package names of the apps whose Health Connect sessions are Gym Day sessions (for the duration)
HEALTHCONNECT_GYMDAY_APPS=com.anthonyng.workoutapp

# --- Finance: bank accounts through Enable Banking (see docs/finance.md) ---
# Application id and its private key (the .pem file as one line: base64 -w0 key.pem)
ENABLEBANKING_APP_ID=
ENABLEBANKING_PRIVATE_KEY=
# Compass' finance page, registered as redirect URL of the app: https://<compass>/finance
ENABLEBANKING_REDIRECT_URL=
# Hours between fetches (banks allow about 4 a day without you present)
FINANCE_SYNC_HOURS=6

# --- Push notifications (web push to the installed PWA) ---
# Create the pair with: make vapid-keys (or on the server:
# docker compose --env-file .env -f infra/docker-compose.yml exec api python -m app.services.push)
# Empty disables push. A new pair means every device has to sign up again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services (mailto: or https:), empty uses MCP_PUBLIC_URL
VAPID_SUBJECT=
# Quiet hours (local, whole hours): only the bedtime reminder comes in between
PUSH_QUIET_START=23
PUSH_QUIET_END=8
# The bedtime reminder comes this many minutes before the latest bedtime
PUSH_BEDTIME_LEAD_MINUTES=30

# --- MCP server for Claude ---
# Public URL Claude connects to (the endpoint is <url>/mcp). Locally http://localhost:8081
MCP_PUBLIC_URL=http://localhost:8081
# Caddy site for it: keep ":8081" when a reverse proxy in front terminates TLS
COMPASS_MCP_SITE_ADDRESS=:8081
# Optional: restrict /mcp, /token, /register, /revoke to these ranges (space separated).
# Anthropic's outbound range is 160.79.104.0/21; Claude Code on your laptop then needs your IP too.
COMPASS_MCP_ALLOWED_IPS=0.0.0.0/0 ::/0
