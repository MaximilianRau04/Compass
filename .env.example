# Every option of Compass (no real values). For a first start you do not need this file:
# make setup writes a small .env. Copy what you need from here into it. Never commit .env.

# --- Mail (IMAP, read-only: EXAMINE and BODY.PEEK, nothing is marked read, moved or deleted) ---
# Names of your accounts, space separated (a-z, 0-9, _). Each name has the variables below with its
# name in capitals. An account is active when its host and user are set. Mail text is never stored.
MAIL_ACCOUNTS=gmail work
MAIL_FOLDERS=INBOX
MAIL_SYNC_MINUTES=15
# How far back the first sync of an account looks
MAIL_LOOKBACK_DAYS=14
# Area of tasks made from a mail, per account (account=area slug), e.g. "work=work gmail=personal"
MAIL_ACCOUNT_AREAS=

# MAIL_TRIAGE_<ACCOUNT>: who summarises its mails. claude (Anthropic API, on the server), local
# (Ollama on a machine of yours, see app/mail/local_triage.py) or rules (headers only, the default).
# Mails can hold personal data of other people: use local for accounts where that matters.
MAIL_TRIAGE_GMAIL=rules
MAIL_TRIAGE_WORK=rules
# For "claude"; without a key those accounts fall back to rules
ANTHROPIC_API_KEY=
MAIL_CLAUDE_MODEL=claude-haiku-4-5
# Bearer token of the local triage runner for /api/ingest/mail/*, create with: openssl rand -hex 32
# Same value on the server and on the machine with Ollama. Empty disables the endpoints.
MAIL_TRIAGE_TOKEN=
# Only on the machine with Ollama: where the runner finds Compass and Ollama
COMPASS_URL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Gmail (app password, requires 2FA). The host can stay unset for an account called gmail.
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=

# Any other account, e.g. one named work. Some servers want a user id, not the full address.
WORK_IMAP_HOST=
WORK_IMAP_PORT=993
WORK_IMAP_USER=
WORK_IMAP_PASSWORD=

# --- News (RSS/Atom feeds) ---
# Feeds can also be added in the app, under Settings.
# Space separated stream:name=url; stream "personal" is ranked by the interest profile,
# "general" is world news. Unset uses the built-in list (backend/app/config.py), empty disables news.
# NEWS_FEEDS="general:bbc=https://feeds.bbci.co.uk/news/world/rss.xml personal:hn=https://hnrss.org/frontpage?points=100"
NEWS_SYNC_MINUTES=60
NEWS_KEEP_DAYS=30

# --- Calendars (ICS, read-only) ---
# Calendars can also be added in the app, under Settings.
# Calendars as space separated name=url pairs, e.g. "google=https://... work=webcal://..."
CALENDAR_ICS_FEEDS=
# Entries of a feed that become tasks instead of events, as semicolon separated feed=regex on the
# title. The matching part is cut from the title, e.g. "moodle= is due$". See docs/deploy.md.
CALENDAR_DEADLINES=
# The calendar subscription URL of ILIAS, if you use it. Works without CALENDAR_DEADLINES.
ILIAS_ICS_URL=
CALENDAR_SYNC_MINUTES=30
# Area per calendar (feed=area slug, e.g. "ilias=study google=personal"): its events take the area's
# colour and follow the area filter
CALENDAR_FEED_AREAS=
# Area slug for new ILIAS deadline tasks, e.g. study (empty: the area of the feed above)
ILIAS_DEADLINE_AREA=

# --- General ---
# Language of the texts the server writes itself (push notifications, the weekly review, mail
# summaries, MCP prompts): en or de. The web app and the Android app follow the device language.
COMPASS_LANGUAGE=en
# Local time zone for "today", deadlines and the sleep analysis
TIMEZONE=Europe/Berlin
# The latest bedtime: up this long before the first appointment, before that this much sleep and
# this long to fall asleep (minutes)
WAKE_BUFFER_MINUTES=120
SLEEP_NEED_MINUTES=450
FALL_ASLEEP_MINUTES=30
# Never later than this (HH:MM, e.g. 01:00), even when the first appointment is in the afternoon;
# empty: only the calculation above
LATEST_BEDTIME=
# Zone 2 as a share of the maximum heart rate (the goal hr_max, see README)
ZONE2_MIN_PERCENT=60
ZONE2_MAX_PERCENT=70

# --- Deployment (server only) ---
# Where the server pulls the images from: ghcr.io/maximilianrau04 for the published ones, or
# ghcr.io/<GitHub user or organisation, lowercase> for the images of your fork's CI
COMPASS_REGISTRY=

# --- Database ---
POSTGRES_USER=compass
POSTGRES_PASSWORD=
POSTGRES_DB=compass
POSTGRES_PORT=5432

# --- Web ---
# Host address and port Caddy is published on (localhost only by default)
COMPASS_HTTP_PORT=127.0.0.1:8080
# Caddy site address, ":80" both locally and on the server (TLS ends at the host proxy there)
COMPASS_SITE_ADDRESS=:80
# "off" behind a TLS proxy (and for a public domain as site address, where Caddy gets its own
# certificate); "netcup" gets Let's Encrypt via the netcup DNS challenge for a VPN-only server.
# Other DNS providers: see docs/deploy.md.
COMPASS_TLS_MODE=off

# --- netcup DNS API (only for COMPASS_TLS_MODE=netcup, customer panel, master data, API) ---
NETCUP_CUSTOMER_NUMBER=
NETCUP_API_KEY=
NETCUP_API_PASSWORD=

# --- Login (Caddy basic auth) ---
COMPASS_BASIC_AUTH_USER=admin
# bcrypt hash, create with: make password-hash
# Every $ in the hash must be written as $$ (Docker Compose escaping).
COMPASS_BASIC_AUTH_HASH=

# --- Health Connect bridge app (android/) ---
# Bearer token the app sends to /api/ingest/healthconnect, create with: openssl rand -hex 32
# Empty disables the endpoint.
HEALTHCONNECT_TOKEN=
# Package names of the apps whose Health Connect sessions are Gym Day sessions (for the duration)
HEALTHCONNECT_GYMDAY_APPS=com.anthonyng.workoutapp

# --- Finance: bank accounts through Enable Banking (see docs/finance.md) ---
# Application id and its private key (the .pem file as one line: base64 -w0 key.pem)
ENABLEBANKING_APP_ID=
ENABLEBANKING_PRIVATE_KEY=
# Compass' finance page, registered as redirect URL of the app: https://<compass>/finance
ENABLEBANKING_REDIRECT_URL=
# Hours between fetches (banks allow about 4 a day without you present)
FINANCE_SYNC_HOURS=6
# Country of your bank (ISO code); Enable Banking only covers the EU and EEA
FINANCE_COUNTRY=DE
# Built-in merchant rules by country, space separated. So far there is "de"; empty leaves only the
# international ones (Spotify, Netflix, Amazon, ...).
FINANCE_RULE_SETS=de

# --- Push notifications (web push to the installed PWA) ---
# Create the pair with: make vapid-keys after make setup (or on a server that pulls its images:
# docker compose --env-file .env -f infra/docker-compose.yml exec api python -m app.services.push)
# Empty disables push. A new pair means every device has to sign up again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services (mailto: or https:), empty uses MCP_PUBLIC_URL
VAPID_SUBJECT=
# Quiet hours (local, whole hours): only the bedtime reminder comes in between
PUSH_QUIET_START=23
PUSH_QUIET_END=8
# The bedtime reminder comes this many minutes before the latest bedtime
PUSH_BEDTIME_LEAD_MINUTES=30

# --- MCP server for AI assistants ---
# Public URL your assistant connects to (the endpoint is <url>/mcp). Locally http://localhost:8081
MCP_PUBLIC_URL=http://localhost:8081
# Host address and port Caddy publishes it on (localhost only by default)
COMPASS_MCP_HTTP_PORT=127.0.0.1:8081
# Caddy site for it: keep ":8081" when a reverse proxy in front terminates TLS
COMPASS_MCP_SITE_ADDRESS=:8081
# Optional: restrict /mcp, /token, /register, /revoke to these ranges (space separated).
# For Claude, Anthropic's outbound range is 160.79.104.0/21. A local MCP client then needs your IP too.
COMPASS_MCP_ALLOWED_IPS=0.0.0.0/0 ::/0
